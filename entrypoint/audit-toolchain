#!/usr/bin/env bash
# audit-toolchain — toolkit-level CLI entry for the audit-toolchain image.
#
# Handles the toolkit's own subcommands and forwards anything else to the
# underlying tool so existing `docker run audit-toolchain:<tag> <tool> ...`
# usage keeps working. With no arguments and a TTY, drops into an interactive
# bash. With no arguments and no TTY (non-interactive), prints help and exits
# 1 so automation sees a clear error instead of a silent exit 0.

set -eu

manifest=/usr/local/share/audit-toolchain/tools.tsv
metadata=/usr/local/share/audit-toolchain/metadata.txt

print_help() {
  cat <<'USAGE'
audit-toolchain — language-agnostic, audit-time tools packaged as a single Docker image.

Usage:
  docker run --rm [--network=none] -v "$PWD:/workspace" audit-toolchain:<tag> [SUBCOMMAND | TOOL [ARG...]]

Toolkit subcommands:
  --help, help                 Print this message.
  --version, version           Print toolkit metadata and image-build info.
  --list-tools, list-tools     List installed audit tools as TSV
                               (name<TAB>version<TAB>category), one per line.

Anything else is exec'd as a command in the image. With no arguments and a
TTY (-it), an interactive bash is started. With no arguments and no TTY, an
error is returned so automation does not silently treat a no-op as success.

Examples:
  docker run --rm audit-toolchain:dev --version
  docker run --rm audit-toolchain:dev --list-tools
  docker run --rm --network=none -v "$PWD:/workspace" audit-toolchain:dev ruff check .

See README.md (https://github.com/kitsuyui/audit-toolchain) for network
policy and the full tool catalogue.
USAGE
}

print_version() {
  if [ -r "$metadata" ]; then
    cat "$metadata"
  else
    # Fall back to the runtime env promoted from the build ARG. We do not
    # synthesise a version here so any drift is visible rather than
    # papered over.
    echo "audit-toolchain ${AUDIT_TOOLCHAIN_VERSION:-unknown}"
  fi
}

print_list_tools() {
  if [ ! -r "$manifest" ]; then
    printf 'audit-toolchain: level=error event=manifest_not_found path=%s\n' "$manifest" >&2
    return 2
  fi
  cat "$manifest"
}

timestamp_utc() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

logfmt_value() {
  local value="$1"
  local char=""
  local encoded=""
  local out=""
  local i=0

  case "$value" in
    '' | *[!A-Za-z0-9_./:-]*)
      for ((i = 0; i < ${#value}; i++)); do
        char="${value:i:1}"
        case "$char" in
          \\)
            out="${out}\\\\"
            ;;
          '"')
            out="${out}\\\""
            ;;
          $'\n')
            out="${out}\\n"
            ;;
          $'\r')
            out="${out}\\r"
            ;;
          $'\t')
            out="${out}\\t"
            ;;
          [[:cntrl:]])
            printf -v encoded '\\x%02X' "'$char"
            out="${out}${encoded}"
            ;;
          *)
            out="${out}${char}"
            ;;
        esac
      done
      printf '"%s"' "$out"
      ;;
    *)
      printf '%s' "$value"
      ;;
  esac
}

run_tool() {
  local tool="$1"
  local tool_logfmt
  local arg_count
  local child_pid=""
  local pending_signal=""
  local status=0
  local signal_status=0
  local rewaiting=0

  arg_count=$(($# - 1))
  tool_logfmt="$(logfmt_value "$tool")"

  printf 'audit-toolchain: level=info event=tool_start tool=%s arg_count=%s at=%s\n' \
    "$tool_logfmt" "$arg_count" "$(timestamp_utc)" >&2

  trap 'pending_signal=TERM; if [ -n "$child_pid" ]; then kill -TERM "$child_pid" 2>/dev/null || true; fi' TERM
  trap 'pending_signal=INT; if [ -n "$child_pid" ]; then kill -INT "$child_pid" 2>/dev/null || true; fi' INT

  "$@" &
  child_pid=$!

  case "$pending_signal" in
    TERM)
      kill -TERM "$child_pid" 2>/dev/null || true
      ;;
    INT)
      kill -INT "$child_pid" 2>/dev/null || true
      ;;
  esac

  while true; do
    set +e
    wait "$child_pid"
    status=$?
    set -e

    if [ "$status" -eq 0 ]; then
      break
    fi

    if [ -n "$pending_signal" ] && [ "$status" -gt 128 ]; then
      pending_signal=""
      signal_status=$status
      rewaiting=1
      continue
    fi

    # POSIX: wait on an already-reaped PID returns 127. If that happens during
    # the signal-driven re-wait phase (rewaiting=1), restore the signal exit
    # status so callers see the correct code instead of 127 ("command not found").
    # The flag is consumed here (one-shot) so a stale signal_status cannot match
    # a subsequent wait that returns 127 for an unrelated reason.
    if [ "$status" -eq 127 ] && [ "$rewaiting" -eq 1 ]; then
      rewaiting=0
      status=$signal_status
    fi

    break
  done

  trap - TERM INT

  local level="info"
  local event="tool_finish"
  if [ "$status" -eq 130 ] || [ "$status" -eq 143 ]; then
    level="warn"
    event="tool_killed"
  elif [ "$status" -ne 0 ]; then
    level="error"
    event="tool_finish"
  fi

  printf 'audit-toolchain: level=%s event=%s tool=%s exit_code=%s at=%s\n' \
    "$level" "$event" "$tool_logfmt" "$status" "$(timestamp_utc)" >&2

  return "$status"
}

if [ "$#" -eq 0 ]; then
  if [ -t 0 ]; then
    exec bash
  else
    print_help >&2
    printf 'audit-toolchain: level=error event=no_tool_specified reason=no_tty\n' >&2
    exit 1
  fi
fi

case "$1" in
  --help|-h|help)
    print_help
    exit 0
    ;;
  --version|-V|version)
    print_version
    exit 0
    ;;
  --list-tools|list-tools)
    print_list_tools
    exit $?
    ;;
  *)
    run_tool "$@"
    ;;
esac
