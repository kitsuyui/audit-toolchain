#!/usr/bin/env bash
# audit-toolchain — toolkit-level CLI entry for the audit-toolchain image.
#
# Handles the toolkit's own subcommands and forwards anything else to the
# underlying tool so existing `docker run audit-toolchain:<tag> <tool> ...`
# usage keeps working. With no arguments and a TTY, drops into an interactive
# bash. With no arguments and no TTY (non-interactive), prints help and exits
# 1 so automation sees a clear error instead of a silent exit 0.

set -eu

manifest=/usr/local/share/audit-toolchain/tools.tsv
metadata=/usr/local/share/audit-toolchain/metadata.txt

print_help() {
  cat <<'USAGE'
audit-toolchain — language-agnostic, audit-time tools packaged as a single Docker image.

Usage:
  docker run --rm [--network=none] -v "$PWD:/workspace" audit-toolchain:<tag> [SUBCOMMAND | TOOL [ARG...]]

Toolkit subcommands:
  --help, help                 Print this message.
  --version, version           Print toolkit metadata and image-build info.
  --list-tools, list-tools     List installed audit tools as TSV
                               (name<TAB>version<TAB>category), one per line.

Anything else is exec'd as a command in the image. With no arguments and a
TTY (-it), an interactive bash is started. With no arguments and no TTY, an
error is returned so automation does not silently treat a no-op as success.

Examples:
  docker run --rm audit-toolchain:dev --version
  docker run --rm audit-toolchain:dev --list-tools
  docker run --rm --network=none -v "$PWD:/workspace" audit-toolchain:dev ruff check .

See README.md (https://github.com/kitsuyui/audit-toolchain) for network
policy and the full tool catalogue.
USAGE
}

print_version() {
  if [ -r "$metadata" ]; then
    cat "$metadata"
  else
    # Fall back to the runtime env promoted from the build ARG. We do not
    # synthesise a version here so any drift is visible rather than
    # papered over.
    echo "audit-toolchain ${AUDIT_TOOLCHAIN_VERSION:-unknown}"
  fi
}

print_list_tools() {
  if [ ! -r "$manifest" ]; then
    echo "audit-toolchain: tool manifest not found at $manifest" >&2
    return 2
  fi
  cat "$manifest"
}

timestamp_utc() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

run_tool() {
  local tool="$1"
  local arg_count
  local child_pid
  local status=0

  arg_count=$(($# - 1))

  printf 'audit-toolchain: starting tool=%s arg_count=%s at=%s\n' \
    "$tool" "$arg_count" "$(timestamp_utc)" >&2

  "$@" &
  child_pid=$!

  trap 'kill -TERM "$child_pid" 2>/dev/null || true' TERM
  trap 'kill -INT "$child_pid" 2>/dev/null || true' INT

  if wait "$child_pid"; then
    status=0
  else
    status=$?
  fi

  trap - TERM INT

  printf 'audit-toolchain: finished tool=%s exit_code=%s at=%s\n' \
    "$tool" "$status" "$(timestamp_utc)" >&2

  return "$status"
}

if [ "$#" -eq 0 ]; then
  if [ -t 0 ]; then
    exec bash
  else
    print_help >&2
    printf '\naudit-toolchain: no tool specified (stdin is not a TTY). Pass a tool name, or use -it for an interactive shell.\n' >&2
    exit 1
  fi
fi

case "$1" in
  --help|-h|help)
    print_help
    exit 0
    ;;
  --version|-V|version)
    print_version
    exit 0
    ;;
  --list-tools|list-tools)
    print_list_tools
    exit $?
    ;;
  *)
    run_tool "$@"
    ;;
esac
